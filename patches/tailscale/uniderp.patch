+		}
+	})
+	var received atomic.Int64
+	wg.Go(func() {
+		for {
+			m, err := fast.Recv()
+			if err != nil {
+				return
+			}
+			if _, ok := m.(derp.ReceivedPacket); ok {
+				received.Add(1)
+			}
+		}
+	})
+	wg.Go(func() {
+		for fast.Send(kf.Public(), []byte("fast")) == nil {
+			time.Sleep(10 * time.Millisecond)
+		}
+	})
+	time.Sleep(600 * time.Millisecond)
+	s.mu.Lock()
+	cs, _ := s.clients.Load(ks.Public())
+	q := cs.activeClient.Load()
+	queued := len(q.sendQueue)
+	limit := s.perClientSendQueueDepth
+	s.mu.Unlock()
+	if queued > limit {
+		t.Fatalf("slow receiver queue exceeded bound %d > %d", queued, limit)
+	}
+	if received.Load() < 10 {
+		t.Fatalf("other flow stalled: %d packets", received.Load())
+	}
+	s.Close()
+	wg.Wait()
