+func TestUniDERPPrivateKeyProof(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	claimed, attacker := key.NewNode(), key.NewNode()
+	s.SetUniDERPKeys(map[key.NodePublic]string{claimed.Public(): "tailnet-a"})
+	var frame bytes.Buffer
+	w := bufio.NewWriter(&frame)
+	sealed := attacker.SealTo(s.PublicKey(), []byte(`{"version":2}`))
+	derp.WriteFrameHeader(w, derp.FrameClientInfo, uint32(key.NodePublicRawLen+len(sealed)))
+	claimed.Public().WriteRawWithoutAllocating(w)
+	w.Write(sealed)
+	w.Flush()
+	if _, _, err := s.recvClientKey(bufio.NewReader(&frame)); err == nil {
+		t.Fatal("forged private key proof accepted")
+	}
+}
