+package main
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestUniDERPRoutesPreserveDERP(t *testing.T) {
+	backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, r.URL.Path) }))
+	defer backend.Close()
+	for _, tls := range []bool{false, true} {
+		mux := http.NewServeMux()
+		mux.HandleFunc("/derp", func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, "derp") })
+		mux.HandleFunc("/derp/probe", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) })
+		mux.HandleFunc("/generate_204", func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusNoContent) })
+		if err := mountUniDERPRoutes(mux, backend.URL); err != nil {
+			t.Fatal(err)
+		}
+		var server *httptest.Server
+		if tls {
+			server = httptest.NewTLSServer(mux)
+		} else {
+			server = httptest.NewServer(mux)
+		}
+		for path, want := range map[string]string{"/derp": "derp", "/cluster/v1/challenge": "/cluster/v1/challenge", "/api/v1/users": "/api/v1/users", "/manage/": "/manage/"} {
+			resp, err := server.Client().Get(server.URL + path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			body, err := io.ReadAll(resp.Body)
+			resp.Body.Close()
+			if err != nil || resp.StatusCode != 200 || string(body) != want {
+				t.Fatalf("%s: %d %s %v", path, resp.StatusCode, body, err)
+			}
+		}
+		for _, path := range []string{"/derp/probe", "/generate_204"} {
+			resp, err := server.Client().Get(server.URL + path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			resp.Body.Close()
+			if resp.StatusCode != 204 {
+				t.Fatalf("probe %s: %d", path, resp.StatusCode)
+			}
+		}
+		server.Close()
+	}
+}
+
+func TestUniDERPManagementBackendOnlyLoopback(t *testing.T) {
+	for _, url := range []string{"http://example.com:80", "https://127.0.0.1:1234", "http://127.0.0.1:1234/path", "http://user@127.0.0.1:1234", "http://127.0.0.1:1234?x=1", "http://127.0.0.1:1234#x", "http://127.0.0.1"} {
+		if err := mountUniDERPRoutes(http.NewServeMux(), url); err == nil {
+			t.Fatalf("accepted backend %s", url)
+		}
+	}
+}
