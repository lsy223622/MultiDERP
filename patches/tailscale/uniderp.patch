+func TestUniDERPQoSOnRelayDataPath(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	keys := map[key.NodePublic]string{}
+	type flow struct {
+		a, b        key.NodePrivate
+		id          string
+		index, size int
+	}
+	var flows []flow
+	for _, f := range []struct {
+		id                       string
+		index, size, connections int
+	}{{"owner", 0, 1200, 1}, {"a", 1, 300, 1}, {"b", 2, 1200, 8}} {
+		for range f.connections {
+			a, b := key.NewNode(), key.NewNode()
+			keys[a.Public()] = f.id
+			keys[b.Public()] = f.id
+			flows = append(flows, flow{a, b, f.id, f.index, f.size})
+		}
+	}
+	installTestPolicy(t, s, testUniDERPPolicy(keys, time.Now()))
+	s.SetUniDERPQoS(400000, 8, 2, 0, []UniDERPTailnetQoS{{"owner", "owner", 1, 0}, {"a", "shared", 2, 0}, {"b", "shared", 1, 0}})
+	var counts [3]atomic.Int64
+	var maxLatency atomic.Int64
+	var wg sync.WaitGroup
+	var memoryBefore runtime.MemStats
+	runtime.ReadMemStats(&memoryBefore)
+	for _, f := range flows {
+		a, b := uniderpClient(t, s, f.a), uniderpClient(t, s, f.b)
+		for _, c := range []*derp.Client{a, b} {
+			if _, err := c.Recv(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		for _, direction := range []struct {
+			sender, receiver *derp.Client
+			destination      key.NodePublic
+		}{{a, b, f.b.Public()}, {b, a, f.a.Public()}} {
+			wg.Go(func() {
+				for {
+					m, err := direction.receiver.Recv()
+					if err != nil {
+						return
+					}
+					if p, ok := m.(derp.ReceivedPacket); ok {
+						counts[f.index].Add(int64(len(p.Data)))
+						delay := time.Now().UnixNano() - int64(binary.LittleEndian.Uint64(p.Data))
+						for {
+							previous := maxLatency.Load()
+							if delay <= previous || maxLatency.CompareAndSwap(previous, delay) {
+								break
+							}
+						}
+					}
+				}
+			})
+			wg.Go(func() {
+				payload := make([]byte, f.size)
+				for {
+					binary.LittleEndian.PutUint64(payload, uint64(time.Now().UnixNano()))
+					if direction.sender.Send(direction.destination, payload) != nil {
+						return
+					}
+				}
+			})
+		}
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	var peakQueue uint64
+	var sampled UniDERPAppliedPolicy
+	for time.Now().Before(deadline) {
+		sampled = s.UniDERPPolicyStatus()
+		var queued uint64
+		for _, counter := range sampled.Traffic {
+			if counter.QueuedPayloadBytes > uniderpTailnetQueueBytes {
+				t.Fatal("data path exceeded tailnet byte budget", counter)
+			}
+			queued += counter.QueuedPayloadBytes
+		}
+		if queued > peakQueue {
+			peakQueue = queued
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	var memoryAfter runtime.MemStats
+	runtime.ReadMemStats(&memoryAfter)
+	t.Logf("bidirectional stats=%+v peak queued payload=%d bytes heap before=%d after=%d max end-to-end packet delay=%s", sampled.Traffic, peakQueue, memoryBefore.HeapAlloc, memoryAfter.HeapAlloc, time.Duration(maxLatency.Load()))
+	s.Close()
+	wg.Wait()
+	o, a, b := counts[0].Load(), counts[1].Load(), counts[2].Load()
+	t.Logf("received payload bytes owner=%d a=%d b=%d", o, a, b)
+	if float64(o)/float64(a+b) < 3.3 || float64(o)/float64(a+b) > 4.7 {
+		t.Fatal("data-path group ratio incorrect")
+	}
+	if float64(a)/float64(b) < 1.5 || float64(a)/float64(b) > 2.5 {
+		t.Fatal("data-path tailnet ratio incorrect")
+	}
+	if o+a+b < 600000 || o+a+b > 900000 {
+		t.Fatal("RX/TX budget not applied independently or throughput too low")
+	}
+}
