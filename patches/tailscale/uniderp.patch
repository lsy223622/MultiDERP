+	"tailscale.com/types/logger"
+)
+
+func uniderpClient(t *testing.T, s *Server, k key.NodePrivate) *derp.Client {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	in, err := ln.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, fakeClock := s.clock.(*tstest.Clock); fakeClock {
+		// Linux TCP statistics reschedule inside fake-clock callbacks.
+		in = struct{ net.Conn }{in}
+	}
+	go s.Accept(context.Background(), in, bufio.NewReadWriter(bufio.NewReader(in), bufio.NewWriter(in)), "127.0.0.1:12345")
+	conn.SetDeadline(time.Now().Add(3 * time.Second))
+	c, err := derp.NewClient(k, conn, bufio.NewReadWriter(bufio.NewReader(conn), bufio.NewWriter(conn)), logger.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func TestKnownKeysAndUnknownKeyDenied(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	a, b := key.NewNode(), key.NewNode()
+	installTestPolicy(t, s, testUniDERPPolicy(map[key.NodePublic]string{a.Public(): "tailnet-a", b.Public(): "tailnet-a"}, time.Now()))
+	ca, cb := uniderpClient(t, s, a), uniderpClient(t, s, b)
+	for _, c := range []*derp.Client{ca, cb} {
+		if _, err := c.Recv(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	unknown := uniderpClient(t, s, key.NewNode())
+	if _, err := unknown.Recv(); err == nil {
+		t.Fatal("unknown key admitted")
+	}
+	for _, size := range []int{64, 1200, 60000} {
+		payload := bytes.Repeat([]byte{42}, size)
+		if err := ca.Send(b.Public(), payload); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			msg, err := cb.Recv()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if p, ok := msg.(derp.ReceivedPacket); ok {
+				if p.Source != a.Public() || !bytes.Equal(p.Data, payload) {
+					t.Fatal("relay payload mismatch")
+				}
+				break
+			}
+		}
+	}
+	s.mu.Lock()
+	cs, _ := s.clients.Load(a.Public())
+	got := cs.activeClient.Load().uniderpTailnet
+	s.mu.Unlock()
+	if got != "tailnet-a" {
+		t.Fatalf("binding = %q", got)
+	}
+}
+
+func TestUniDERPEmptyPolicyRejects(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	installTestPolicy(t, s, testUniDERPPolicy(map[key.NodePublic]string{}, time.Now()))
+	c := uniderpClient(t, s, key.NewNode())
+	if _, err := c.Recv(); err == nil {
+		t.Fatal("empty policy opened admission")
+	}
+}
+
+func TestKnownKeyRequiresPrivateProof(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	claimed, attacker := key.NewNode(), key.NewNode()
+	installTestPolicy(t, s, testUniDERPPolicy(map[key.NodePublic]string{claimed.Public(): "tailnet-a"}, time.Now()))
+	var frame bytes.Buffer
+	w := bufio.NewWriter(&frame)
+	sealed := attacker.SealTo(s.PublicKey(), []byte(`{"version":2}`))
+	derp.WriteFrameHeader(w, derp.FrameClientInfo, uint32(key.NodePublicRawLen+len(sealed)))
+	claimed.Public().WriteRawWithoutAllocating(w)
+	w.Write(sealed)
+	w.Flush()
+	if _, _, err := s.recvClientKey(bufio.NewReader(&frame)); err == nil {
+		t.Fatal("forged private key proof accepted")
+	}
+}
