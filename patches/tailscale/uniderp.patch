+package derpserver
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"reflect"
+	"time"
+
+	"tailscale.com/types/key"
+)
+
+type UniDERPAppliedPolicy struct {
+	Revision          uint64                  `json:"revision"`
+	Usable            bool                    `json:"usable"`
+	Traffic           []UniDERPTailnetTraffic `json:"traffic,omitempty"`
+	TrafficObservedAt time.Time               `json:"traffic_observed_at"`
+	ActiveConnections uint64                  `json:"active_connections"`
+}
+
+type uniderpBinding struct {
+	tailnet  string
+	grant    string
+	until    time.Time
+	deadline time.Time
+}
+
+type uniderpPolicyState struct {
+	policy  UniDERPPolicy
+	digest  [32]byte
+	keys    map[key.NodePublic]uniderpBinding
+	traffic map[string]*uniderpTraffic
+}
+
+func (s *Server) EnableUniDERP() {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.uniderpPolicy == nil {
+		s.uniderpPolicy = &uniderpPolicyState{keys: make(map[key.NodePublic]uniderpBinding)}
+		s.uniderpObserved = s.clock.Now()
+		s.uniderpScheduleLocked()
+	}
+}
+
+func (s *Server) ApplyUniDERPPolicy(body []byte) (UniDERPAppliedPolicy, error) {
+	if len(body) > MaxUniDERPPolicyBytes {
+		return UniDERPAppliedPolicy{}, errors.New("UniDERP policy too large")
+	}
+	var identity struct {
+		ClusterID string `json:"cluster_id"`
+		NodeID    string `json:"node_id"`
+	}
+	if err := json.Unmarshal(body, &identity); err != nil {
+		return UniDERPAppliedPolicy{}, err
+	}
+	p, err := DecodeUniDERPPolicy(bytes.NewReader(body), identity.ClusterID, identity.NodeID)
+	if err != nil {
+		return UniDERPAppliedPolicy{}, err
+	}
+	digest := sha256.Sum256(body)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.uniderpClockBad {
+		return UniDERPAppliedPolicy{}, errors.New("UniDERP policy unavailable")
+	}
+	now := s.clock.Now()
+	if !s.uniderpClockValidLocked(now) {
+		return UniDERPAppliedPolicy{}, errors.New("UniDERP clock rollback")
+	}
+	old := s.uniderpPolicy
+	if old != nil && old.policy.Revision != 0 {
+		if old.policy.ClusterID != p.ClusterID || old.policy.NodeID != p.NodeID || p.Revision < old.policy.Revision || (p.Revision == old.policy.Revision && digest != old.digest) {
+			return UniDERPAppliedPolicy{}, errors.New("UniDERP policy revision conflict")
+		}
+		if p.Revision == old.policy.Revision {
+			return s.uniderpStatusLocked(now), nil
+		}
+	}
+	keys := make(map[key.NodePublic]uniderpBinding)
+	for _, g := range p.Grants {
+		for _, k := range g.Keys {
+			var pub key.NodePublic
+			pub.UnmarshalText([]byte(k.NodePublic))
+			until := UniDERPEffectiveUntil(g, k)
+			deadline := now.Add(until.Sub(now))
+			if old != nil {
+				if previous, ok := old.keys[pub]; ok && !until.After(previous.until) && previous.deadline.Before(deadline) {
+					deadline = previous.deadline
+				}
+			}
+			keys[pub] = uniderpBinding{tailnet: g.TailnetID, grant: g.GrantID, until: until, deadline: deadline}
+		}
+	}
+	if old == nil || !reflect.DeepEqual(old.policy.QoS, p.QoS) {
+		rules := make([]UniDERPTailnetQoS, 0, len(p.QoS.Tailnets))
+		for _, r := range p.QoS.Tailnets {
+			rules = append(rules, UniDERPTailnetQoS{TailnetID: r.TailnetID, Group: r.Group, Weight: r.Weight, MaxBytesPerSec: r.MaxBPS / 8})
+		}
+		s.SetUniDERPQoS(p.QoS.BudgetBPS/8, p.QoS.OwnerWeight, p.QoS.SharedWeight, p.QoS.SharedMaxBPS/8, rules)
+	}
+	traffic := make(map[string]*uniderpTraffic, len(p.QoS.Tailnets))
+	for _, rule := range p.QoS.Tailnets {
+		var counters *uniderpTraffic
+		if old != nil {
+			counters = old.traffic[rule.TailnetID]
+		}
+		if counters == nil {
+			counters = new(uniderpTraffic)
+			s.uniderpTrafficSequence++
+			if s.uniderpTrafficSequence == 0 {
+				s.uniderpTrafficSequence++
+			}
+			counters.id = s.uniderpTrafficSequence
+		}
+		counters.group = 0
+		if rule.Group == "shared" {
+			counters.group = 1
+		}
+		traffic[rule.TailnetID] = counters
+	}
+	s.uniderpPolicy = &uniderpPolicyState{policy: p, digest: digest, keys: keys, traffic: traffic}
+	s.uniderpReapLocked(now)
+	s.uniderpScheduleLocked()
+	return s.uniderpStatusLocked(now), nil
+}
+
+func (s *Server) uniderpClockValidLocked(now time.Time) bool {
+	if now.Before(s.uniderpObserved.Add(-5 * time.Second)) {
+		s.uniderpClockBad = true
+	}
+	if now.After(s.uniderpObserved) {
+		s.uniderpObserved = now
+	}
+	return !s.uniderpClockBad
+}
+
+func (s *Server) uniderpBindingLocked(k key.NodePublic) (uniderpBinding, bool) {
+	if s.uniderpPolicy == nil {
+		return uniderpBinding{}, true
+	}
+	now := s.clock.Now()
+	if !s.uniderpClockValidLocked(now) {
+		return uniderpBinding{}, false
+	}
+	b, ok := s.uniderpPolicy.keys[k]
+	return b, ok && now.Before(b.until) && now.Before(b.deadline)
+}
+
+func (s *Server) uniderpClientAllowedLocked(c *sclient) bool {
+	if s.uniderpPolicy == nil {
+		return true
+	}
+	b, ok := s.uniderpBindingLocked(c.key)
+	return ok && b.tailnet == c.uniderpTailnet && b.grant == c.uniderpGrant
+}
+
+func (s *Server) uniderpClientAllowed(c *sclient) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.uniderpClientAllowedLocked(c)
+}
+
+func (s *Server) uniderpReapLocked(now time.Time) {
+	s.uniderpClockValidLocked(now)
+	for _, set := range s.clients.All() {
+		set.ForeachClient(func(c *sclient) {
+			if s.uniderpClientAllowedLocked(c) {
+				return
+			}
+			if c.uniderpCancel != nil {
+				c.uniderpCancel()
+			}
+			c.nc.Close()
+			for {
+				select {
+				case p := <-c.sendQueue:
+					p.uniderpRelease()
+				default:
+					goto disco
+				}
+			}
+		disco:
+			for {
+				select {
+				case p := <-c.discoSendQueue:
+					p.uniderpRelease()
+				default:
+					return
+				}
+			}
+		})
+	}
+}
+
+func (s *Server) uniderpScheduleLocked() {
+	if s.closed {
+		return
+	}
+	if s.uniderpTimer != nil {
+		s.uniderpTimer.Stop()
+	}
+	now := s.clock.Now()
+	delay := time.Second
+	for _, b := range s.uniderpPolicy.keys {
+		if d := b.deadline.Sub(now); d > 0 && d < delay {
+			delay = d
+		}
+	}
+	s.uniderpTimer = s.clock.AfterFunc(delay, func() {
+		// Test clocks can fire callbacks while holding their own clock mutex.
+		go func() {
+			s.mu.Lock()
+			defer s.mu.Unlock()
+			if s.closed {
+				return
+			}
+			s.uniderpReapLocked(s.clock.Now())
+			s.uniderpScheduleLocked()
+		}()
+	})
+}
+
+func (s *Server) uniderpStatusLocked(now time.Time) UniDERPAppliedPolicy {
+	if s.uniderpPolicy == nil {
+		return UniDERPAppliedPolicy{}
+	}
+	result := UniDERPAppliedPolicy{Revision: s.uniderpPolicy.policy.Revision, Traffic: s.uniderpTrafficLocked(), TrafficObservedAt: now.UTC()}
+	result.ActiveConnections = uint64(max(s.curClients.Value(), 0))
+	if !s.uniderpClockValidLocked(now) {
+		return result
+	}
+	for _, b := range s.uniderpPolicy.keys {
+		if now.Before(b.until) && now.Before(b.deadline) {
+			result.Usable = true
+			break
+		}
+	}
+	return result
+}
+
+func (s *Server) UniDERPPolicyStatus() UniDERPAppliedPolicy {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := s.clock.Now()
+	if s.uniderpPolicy != nil {
+		s.uniderpReapLocked(now)
+	}
+	return s.uniderpStatusLocked(now)
+}
