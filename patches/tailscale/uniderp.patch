+package derpserver
+
+import "tailscale.com/types/key"
+
+func (s *Server) SetUniDERPKeys(keys map[key.NodePublic]string) {
+	copy := make(map[key.NodePublic]string, len(keys))
+	for k, tailnet := range keys {
+		copy[k] = tailnet
+	}
+	s.uniderpKeys.Store(&copy)
+}
