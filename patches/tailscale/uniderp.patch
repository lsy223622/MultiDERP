+package derpserver
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"tailscale.com/derp"
+	"tailscale.com/types/key"
+	"tailscale.com/types/logger"
+	"testing"
+	"time"
+)
+
+func TestUniDERPQoSBytesGroupsAndConnections(t *testing.T) {
+	s := newUniDERPScheduler(1000000, 8, 2, 0, []UniDERPTailnetQoS{{"owner", "owner", 1, 0}, {"a", "shared", 2, 0}, {"b", "shared", 1, 0}})
+	defer s.close()
+	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer cancel()
+	var counts [3]atomic.Int64
+	var wg sync.WaitGroup
+	for _, flow := range []struct {
+		id                       string
+		index, size, connections int
+	}{{"owner", 0, 1200, 1}, {"a", 1, 300, 1}, {"b", 2, 1200, 16}} {
+		for range flow.connections {
+			wg.Go(func() {
+				for s.wait(ctx, flow.id, flow.size) == nil {
+					counts[flow.index].Add(int64(flow.size))
+				}
+			})
+		}
+	}
+	wg.Wait()
+	o, a, b := counts[0].Load(), counts[1].Load(), counts[2].Load()
+	t.Logf("served bytes owner=%d a=%d b=%d", o, a, b)
+	if float64(o)/float64(a+b) < 3.5 || float64(o)/float64(a+b) > 4.5 {
+		t.Fatal("group byte ratio incorrect")
+	}
+	if float64(a)/float64(b) < 1.7 || float64(a)/float64(b) > 2.3 {
+		t.Fatal("tailnet byte ratio incorrect")
+	}
+}
+
+func TestUniDERPQoSOnRelayDataPath(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	keys := map[key.NodePublic]string{}
+	type flow struct {
+		a, b        key.NodePrivate
+		id          string
+		index, size int
+	}
+	var flows []flow
+	for _, f := range []struct {
+		id                       string
+		index, size, connections int
+	}{{"owner", 0, 1200, 1}, {"a", 1, 300, 1}, {"b", 2, 1200, 8}} {
+		for range f.connections {
+			a, b := key.NewNode(), key.NewNode()
+			keys[a.Public()] = f.id
+			keys[b.Public()] = f.id
+			flows = append(flows, flow{a, b, f.id, f.index, f.size})
+		}
+	}
+	installTestPolicy(t, s, testUniDERPPolicy(keys, time.Now()))
+	s.SetUniDERPQoS(400000, 8, 2, 0, []UniDERPTailnetQoS{{"owner", "owner", 1, 0}, {"a", "shared", 2, 0}, {"b", "shared", 1, 0}})
+	var counts [3]atomic.Int64
+	var wg sync.WaitGroup
+	for _, f := range flows {
+		a, b := uniderpClient(t, s, f.a), uniderpClient(t, s, f.b)
+		for _, c := range []*derp.Client{a, b} {
+			if _, err := c.Recv(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		wg.Go(func() {
+			for {
+				m, err := b.Recv()
+				if err != nil {
+					return
+				}
+				if p, ok := m.(derp.ReceivedPacket); ok {
+					counts[f.index].Add(int64(len(p.Data)))
+				}
+			}
+		})
+		wg.Go(func() {
+			payload := make([]byte, f.size)
+			for a.Send(f.b.Public(), payload) == nil {
+			}
+		})
+	}
+	time.Sleep(2 * time.Second)
+	s.Close()
+	wg.Wait()
+	o, a, b := counts[0].Load(), counts[1].Load(), counts[2].Load()
+	t.Logf("received payload bytes owner=%d a=%d b=%d", o, a, b)
+	if float64(o)/float64(a+b) < 3.3 || float64(o)/float64(a+b) > 4.7 {
+		t.Fatal("data-path group ratio incorrect")
+	}
+	if float64(a)/float64(b) < 1.5 || float64(a)/float64(b) > 2.5 {
+		t.Fatal("data-path tailnet ratio incorrect")
+	}
+	if o+a+b < 600000 || o+a+b > 900000 {
+		t.Fatal("RX/TX budget not applied independently or throughput too low")
+	}
+}
+
+func TestUniDERPQoSBorrowingAndCeiling(t *testing.T) {
+	for _, ceiling := range []uint64{0, 200000} {
+		s := newUniDERPScheduler(1000000, 8, 2, ceiling, []UniDERPTailnetQoS{{"a", "shared", 1, 0}})
+		ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+		var n int64
+		for s.wait(ctx, "a", 1200) == nil {
+			n += 1200
+		}
+		cancel()
+		s.close()
+		if ceiling == 0 && n < 800000 {
+			t.Fatalf("idle capacity not borrowed: %d", n)
+		}
+		if ceiling != 0 && n > 200000+2*65536 {
+			t.Fatalf("ceiling exceeded beyond bounded burst: %d", n)
+		}
+	}
+}
+
+func TestUniDERPSlowReceiverDoesNotBlockOtherFlow(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	ka, ks, kf := key.NewNode(), key.NewNode(), key.NewNode()
+	installTestPolicy(t, s, testUniDERPPolicy(map[key.NodePublic]string{ka.Public(): "a", ks.Public(): "b", kf.Public(): "a"}, time.Now()))
+	s.SetUniDERPQoS(16000000, 8, 2, 0, []UniDERPTailnetQoS{{"a", "owner", 1, 0}, {"b", "shared", 1, 0}})
+	a, slow, fast := uniderpClient(t, s, ka), uniderpClient(t, s, ks), uniderpClient(t, s, kf)
+	for _, c := range []*derp.Client{a, slow, fast} {
+		if _, err := c.Recv(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var wg sync.WaitGroup
+	wg.Go(func() {
+		payload := make([]byte, 60000)
+		for a.Send(ks.Public(), payload) == nil {
+		}
+	})
+	var received atomic.Int64
+	wg.Go(func() {
+		for {
+			m, err := fast.Recv()
+			if err != nil {
+				return
+			}
+			if _, ok := m.(derp.ReceivedPacket); ok {
+				received.Add(1)
+			}
+		}
+	})
+	wg.Go(func() {
+		for fast.Send(kf.Public(), []byte("fast")) == nil {
+			time.Sleep(10 * time.Millisecond)
+		}
+	})
+	time.Sleep(600 * time.Millisecond)
+	s.mu.Lock()
+	cs, _ := s.clients.Load(ks.Public())
+	q := cs.activeClient.Load()
+	queued := len(q.sendQueue)
+	limit := s.perClientSendQueueDepth
+	s.mu.Unlock()
+	if queued > limit {
+		t.Fatalf("slow receiver queue exceeded bound %d > %d", queued, limit)
+	}
+	if received.Load() < 10 {
+		t.Fatalf("other flow stalled: %d packets", received.Load())
+	}
+	s.Close()
+	wg.Wait()
+}
+
+func TestUniDERPQoSQueueIsBoundedAndCancellationReleases(t *testing.T) {
+	s := newUniDERPScheduler(1, 8, 2, 0, []UniDERPTailnetQoS{{"a", "shared", 1, 0}})
+	defer s.close()
+	ctx, cancel := context.WithCancel(t.Context())
+	var wg sync.WaitGroup
+	for range 512 {
+		wg.Go(func() { s.wait(ctx, "a", 65536) })
+	}
+	time.Sleep(30 * time.Millisecond)
+	s.mu.Lock()
+	queued := len(s.groups[1].tailnets[0].requests)
+	s.mu.Unlock()
+	if queued > 256 {
+		t.Fatalf("unbounded pending queue: %d", queued)
+	}
+	cancel()
+	wg.Wait()
+}
