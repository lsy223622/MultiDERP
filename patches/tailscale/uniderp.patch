+	s.SetUniDERPQoS(16000000, 8, 2, 0, []UniDERPTailnetQoS{{"a", "owner", 1, 0}, {"b", "shared", 1, 0}})
+	a, slow, fast := uniderpClient(t, s, ka), uniderpClient(t, s, ks), uniderpClient(t, s, kf)
+	for _, c := range []*derp.Client{a, slow, fast} {
