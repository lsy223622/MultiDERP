+func TestUniDERPHTTPUpgradeRelayAndSTUN(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+	defer cancel()
+	backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { io.WriteString(w, "cluster") }))
+	defer backend.Close()
+	udp := stunserver.New(ctx)
+	if err := udp.Listen("127.0.0.1:0"); err != nil {
+		t.Fatal(err)
+	}
+	go udp.Serve()
+	uc, err := net.Dial("udp", udp.LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer uc.Close()
+	uc.SetDeadline(time.Now().Add(2 * time.Second))
+	tx := stun.NewTxID()
+	if _, err := uc.Write(stun.Request(tx)); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 1500)
+	n, err := uc.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got, _, err := stun.ParseResponse(buf[:n])
+	if err != nil || got != tx {
+		t.Fatalf("STUN response: %v", err)
+	}
+	for _, tls := range []bool{false, true} {
+		s := derpserver.New(key.NewNode(), logger.Discard)
+		a, b := key.NewNode(), key.NewNode()
+		now := time.Now()
+		p := derpserver.UniDERPPolicy{ClusterID: "cluster", NodeID: "node", Revision: 1, GeneratedAt: now, Grants: []derpserver.UniDERPGrantPolicy{{GrantID: "a", GrantRevision: 1, TailnetID: "a", LastIdentitySuccess: now, IdentityUntil: now.Add(time.Hour), ControlUntil: now.Add(time.Hour), Keys: []derpserver.UniDERPDeviceKey{{NodePublic: a.Public().String()}, {NodePublic: b.Public().String()}}}}, QoS: derpserver.UniDERPQoSPolicy{BudgetBPS: 8000000000, OwnerWeight: 8, SharedWeight: 2, Tailnets: []derpserver.UniDERPPolicyTailnetQoS{{TailnetID: "a", Group: "owner", Weight: 1}}}}
+		body, _ := json.Marshal(p)
+		if _, err := s.ApplyUniDERPPolicy(body); err != nil {
+			t.Fatal(err)
+		}
+		mux := http.NewServeMux()
+		mux.Handle("/derp", derpserver.Handler(s))
+		mux.HandleFunc("/derp/probe", derpserver.ProbeHandler)
+		if err := mountUniDERPRoutes(mux, backend.URL); err != nil {
+			t.Fatal(err)
+		}
+		var server *httptest.Server
+		if tls {
+			server = httptest.NewTLSServer(mux)
+		} else {
+			server = httptest.NewServer(mux)
+		}
+		ca, err := derphttp.NewClient(a, server.URL+"/derp", logger.Discard, netmon.NewStatic())
+		if err != nil {
+			t.Fatal(err)
+		}
+		cb, err := derphttp.NewClient(b, server.URL+"/derp", logger.Discard, netmon.NewStatic())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if tls {
+			roots := x509.NewCertPool()
+			roots.AddCert(server.Certificate())
+			ca.TLSConfig = &cryptotls.Config{RootCAs: roots}
+			cb.TLSConfig = ca.TLSConfig
+		}
+		for _, c := range []*derphttp.Client{ca, cb} {
+			if err := c.Connect(ctx); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := c.Recv(); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := ca.Send(b.Public(), []byte("uniderp relay")); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			msg, err := cb.Recv()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if p, ok := msg.(derp.ReceivedPacket); ok {
+				if p.Source != a.Public() || string(p.Data) != "uniderp relay" {
+					t.Fatal("payload mismatch")
+				}
+				break
+			}
+		}
+		ca.Close()
+		cb.Close()
+		s.Close()
+		server.Close()
+	}
