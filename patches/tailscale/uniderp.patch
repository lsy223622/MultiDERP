+	s.mu.Unlock()
+	if queued > limit {
+		t.Fatalf("slow receiver queue exceeded bound %d > %d", queued, limit)
+	}
+	if received.Load() < 10 {
+		t.Fatalf("other flow stalled: %d packets", received.Load())
+	}
+	s.Close()
+	wg.Wait()
+}
+
+func TestUniDERPQoSQueueIsBoundedAndCancellationReleases(t *testing.T) {
+	s := newUniDERPScheduler(1, 8, 2, 0, []UniDERPTailnetQoS{{"a", "shared", 1, 0}})
+	defer s.close()
+	ctx, cancel := context.WithCancel(t.Context())
+	var wg sync.WaitGroup
+	for range 512 {
+		wg.Go(func() { s.wait(ctx, "a", 65536) })
+	}
+	time.Sleep(30 * time.Millisecond)
+	s.mu.Lock()
+	queued := len(s.groups[1].tailnets[0].requests)
+	s.mu.Unlock()
+	if queued > 256 {
+		t.Fatalf("unbounded pending queue: %d", queued)
+	}
+	cancel()
+	wg.Wait()
+}
