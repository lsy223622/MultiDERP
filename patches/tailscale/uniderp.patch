+package derpserver
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"time"
+)
+
+type UniDERPTailnetQoS struct {
+	TailnetID      string
+	Group          string
+	Weight         uint32
+	MaxBytesPerSec uint64
+}
+
+func (s *Server) SetUniDERPQoS(budget uint64, ownerWeight, sharedWeight uint32, sharedMax uint64, tailnets []UniDERPTailnetQoS) {
+	rx := newUniDERPScheduler(budget, ownerWeight, sharedWeight, sharedMax, tailnets)
+	tx := newUniDERPScheduler(budget, ownerWeight, sharedWeight, sharedMax, tailnets)
+	if old := s.uniderpRX.Swap(rx); old != nil {
+		old.close()
+	}
+	if old := s.uniderpTX.Swap(tx); old != nil {
+		old.close()
+	}
+}
+
+type uniderpBucket struct {
+	rate   uint64
+	tokens float64
+	last   time.Time
+}
+
+func (b *uniderpBucket) available(now time.Time, n int) bool {
+	if b.rate == 0 {
+		return true
+	}
+	if !b.last.IsZero() {
+		b.tokens += now.Sub(b.last).Seconds() * float64(b.rate)
+	}
+	b.last = now
+	if b.tokens > 65536 {
+		b.tokens = 65536
+	}
+	return b.tokens >= float64(n)
+}
+
+func (b *uniderpBucket) consume(n int) {
+	if b.rate != 0 {
+		b.tokens -= float64(n)
+	}
+}
+
+type uniderpRequest struct {
+	ctx  context.Context
+	size int
+	done chan error
+}
+type uniderpTailnetQueue struct {
+	id        string
+	weight    int64
+	deficit   int64
+	credit    bool
+	bucket    uniderpBucket
+	requests  []*uniderpRequest
+	idleSince time.Time
+}
+type uniderpGroupQueue struct {
+	weight   int64
+	deficit  int64
+	credit   bool
+	bucket   uniderpBucket
+	tailnets []*uniderpTailnetQueue
+	next     int
+}
+type uniderpScheduler struct {
+	mu       sync.Mutex
+	groups   [2]uniderpGroupQueue
+	next     int
+	budget   uniderpBucket
+	wake     chan struct{}
+	stop     chan struct{}
+	stopped  chan struct{}
+	stopOnce sync.Once
+}
+
+func newUniDERPScheduler(budget uint64, ownerWeight, sharedWeight uint32, sharedMax uint64, tailnets []UniDERPTailnetQoS) *uniderpScheduler {
+	s := &uniderpScheduler{budget: uniderpBucket{rate: budget}, wake: make(chan struct{}, 1), stop: make(chan struct{}), stopped: make(chan struct{})}
+	s.groups[0].weight = int64(ownerWeight)
+	s.groups[1].weight = int64(sharedWeight)
+	s.groups[1].bucket.rate = sharedMax
+	for _, t := range tailnets {
+		g := 0
+		if t.Group == "shared" {
+			g = 1
+		}
+		s.groups[g].tailnets = append(s.groups[g].tailnets, &uniderpTailnetQueue{id: t.TailnetID, weight: int64(t.Weight), bucket: uniderpBucket{rate: t.MaxBytesPerSec}})
+	}
+	go s.run()
+	return s
+}
+
+func (s *uniderpScheduler) close() { s.stopOnce.Do(func() { close(s.stop) }); <-s.stopped }
+
+func (s *uniderpScheduler) wait(ctx context.Context, id string, size int) error {
+	if size < 0 || size > 65536 {
+		return errors.New("UniDERP invalid payload size")
+	}
+	r := &uniderpRequest{ctx: ctx, size: size, done: make(chan error, 1)}
+	s.mu.Lock()
+	var q *uniderpTailnetQueue
+	for i := range s.groups {
+		for _, t := range s.groups[i].tailnets {
+			if t.id == id {
+				q = t
+				break
+			}
+		}
+	}
+	if q == nil || len(q.requests) >= 256 {
+		s.mu.Unlock()
+		return errors.New("UniDERP tailnet queue unavailable")
+	}
+	q.requests = append(q.requests, r)
+	q.idleSince = time.Time{}
+	s.mu.Unlock()
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+	select {
+	case err := <-r.done:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-s.stop:
+		return errors.New("UniDERP scheduler stopped")
+	}
+}
+
+func (s *uniderpScheduler) run() {
+	defer close(s.stopped)
+	tick := time.NewTicker(time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-s.stop:
+			return
+		case <-s.wake:
+		case <-tick.C:
+		}
+		s.mu.Lock()
+		for s.step(time.Now()) {
+		}
+		s.mu.Unlock()
+	}
+}
+
+func (s *uniderpScheduler) step(now time.Time) bool {
+	for tries := 0; tries < 512; tries++ {
+		g := &s.groups[s.next]
+		if len(g.tailnets) == 0 {
+			s.next = 1 - s.next
+			continue
+		}
+		if g.credit && g.deficit == 0 {
+			g.credit = false
+			s.next = 1 - s.next
+			continue
+		}
+		t := g.tailnets[g.next]
+		if t.credit && t.deficit == 0 {
+			t.credit = false
+			g.next = (g.next + 1) % len(g.tailnets)
+			continue
+		}
+		for len(t.requests) > 0 && t.requests[0].ctx.Err() != nil {
+			t.requests = t.requests[1:]
+		}
+		if len(t.requests) == 0 {
+			if t.idleSince.IsZero() {
+				t.idleSince = now
+			}
+			if g.credit && g.deficit > 0 && now.Sub(t.idleSince) < 2*time.Millisecond {
+				return false
+			}
+			t.deficit = 0
+			t.credit = false
+			g.next = (g.next + 1) % len(g.tailnets)
+			active := false
+			for _, q := range g.tailnets {
+				if len(q.requests) > 0 {
+					active = true
+					break
+				}
+			}
+			if !active {
+				g.deficit = 0
+				g.credit = false
+				s.next = 1 - s.next
+			}
+			continue
+		}
+		if !g.credit {
+			g.deficit += 1200 * g.weight
+			g.credit = true
+		}
+		if !t.credit {
+			t.deficit += 1200 * t.weight
+			t.credit = true
+		}
+		n := t.requests[0].size
+		if g.deficit < int64(n) {
+			g.credit = false
+			s.next = 1 - s.next
+			continue
+		}
+		if t.deficit < int64(n) {
+			t.credit = false
+			g.next = (g.next + 1) % len(g.tailnets)
+			continue
+		}
+		if !g.bucket.available(now, n) || !t.bucket.available(now, n) {
+			g.next = (g.next + 1) % len(g.tailnets)
+			s.next = 1 - s.next
+			continue
+		}
+		if !s.budget.available(now, n) {
+			return false
+		}
+		s.budget.consume(n)
+		g.bucket.consume(n)
+		t.bucket.consume(n)
+		g.deficit -= int64(n)
+		t.deficit -= int64(n)
+		r := t.requests[0]
+		t.requests = t.requests[1:]
+		r.done <- nil
+		return true
+	}
+	return false
+}
