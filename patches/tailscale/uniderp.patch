+func TestUniDERPQoSBytesGroupsAndConnections(t *testing.T) {
+	s := newUniDERPScheduler(1000000, 8, 2, 0, []UniDERPTailnetQoS{{"owner", "owner", 1, 0}, {"a", "shared", 2, 0}, {"b", "shared", 1, 0}})
+	defer s.close()
+	ctx, cancel := context.WithTimeout(t.Context(), 2*time.Second)
+	defer cancel()
+	var counts [3]atomic.Int64
+	var wg sync.WaitGroup
+	for _, flow := range []struct {
+		id                       string
+		index, size, connections int
+	}{{"owner", 0, 1200, 1}, {"a", 1, 300, 1}, {"b", 2, 1200, 16}} {
+		for range flow.connections {
+			wg.Go(func() {
+				for s.wait(ctx, flow.id, flow.size) == nil {
+					counts[flow.index].Add(int64(flow.size))
+				}
+			})
+		}
+	}
+	wg.Wait()
+	o, a, b := counts[0].Load(), counts[1].Load(), counts[2].Load()
+	t.Logf("served bytes owner=%d a=%d b=%d", o, a, b)
+	if float64(o)/float64(a+b) < 3.5 || float64(o)/float64(a+b) > 4.5 {
+		t.Fatal("group byte ratio incorrect")
+	}
+	if float64(a)/float64(b) < 1.7 || float64(a)/float64(b) > 2.3 {
+		t.Fatal("tailnet byte ratio incorrect")
+	}
