+package derpserver
+
+import "sync/atomic"
+
+const uniderpTailnetQueueBytes = 1 << 20
+const uniderpGroupQueueBytes = 8 << 20
+
+type uniderpTraffic struct {
+	id     uint64
+	queued atomic.Int64
+	rx     atomic.Uint64
+	tx     atomic.Uint64
+	group  int
+}
+
+type UniDERPTailnetTraffic struct {
+	CounterID           uint64 `json:"counter_id"`
+	TailnetID           string `json:"tailnet_id"`
+	RXPayloadBytes      uint64 `json:"rx_payload_bytes"`
+	TXPayloadBytes      uint64 `json:"tx_payload_bytes"`
+	RelayedPayloadBytes uint64 `json:"relayed_payload_bytes"`
+	QueuedPayloadBytes  uint64 `json:"queued_payload_bytes"`
+}
+
+func (c *sclient) recordUniDERPTraffic(bytes int, receive bool) {
+	c.s.mu.Lock()
+	defer c.s.mu.Unlock()
+	if c.s.uniderpPolicy == nil {
+		return
+	}
+	traffic := c.s.uniderpPolicy.traffic[c.uniderpTailnet]
+	if traffic == nil {
+		return
+	}
+	if receive {
+		traffic.rx.Add(uint64(bytes))
+	} else {
+		traffic.tx.Add(uint64(bytes))
+	}
+}
+
+func (s *Server) uniderpTrafficLocked() []UniDERPTailnetTraffic {
+	result := make([]UniDERPTailnetTraffic, 0, len(s.uniderpPolicy.traffic))
+	for _, rule := range s.uniderpPolicy.policy.QoS.Tailnets {
+		traffic := s.uniderpPolicy.traffic[rule.TailnetID]
+		tx := traffic.tx.Load()
+		result = append(result, UniDERPTailnetTraffic{CounterID: traffic.id, TailnetID: rule.TailnetID, RXPayloadBytes: traffic.rx.Load(), TXPayloadBytes: tx, RelayedPayloadBytes: tx, QueuedPayloadBytes: uint64(traffic.queued.Load())})
+	}
+	return result
+}
+
+func (s *Server) uniderpReservePacket(dst *sclient, p *pkt) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.uniderpPolicy == nil {
+		return true
+	}
+	if !s.uniderpClientAllowedLocked(dst) {
+		return false
+	}
+	traffic := s.uniderpPolicy.traffic[dst.uniderpTailnet]
+	if traffic == nil {
+		return false
+	}
+	groupQueued := &s.uniderpGroupQueued[traffic.group]
+	n := int64(len(p.bs))
+	if traffic.queued.Load()+n > uniderpTailnetQueueBytes || groupQueued.Load()+n > uniderpGroupQueueBytes {
+		return false
+	}
+	traffic.queued.Add(n)
+	groupQueued.Add(n)
+	p.uniderpTraffic, p.uniderpGroupQueued = traffic, groupQueued
+	return true
+}
+
+func (p pkt) uniderpRelease() {
+	if p.uniderpTraffic != nil {
+		p.uniderpTraffic.queued.Add(-int64(len(p.bs)))
+		p.uniderpGroupQueued.Add(-int64(len(p.bs)))
+	}
+}
+
+func (c *sclient) sendQueuedPacket(p pkt) error {
+	defer p.uniderpRelease()
+	return c.sendPacket(p.src, p.bs)
+}
