+	"tailscale.com/types/logger"
+)
+
+func writeTestPolicyCache(t *testing.T, path string, p derpserver.UniDERPPolicy) string {
+	t.Helper()
+	body, err := json.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := sha256.Sum256(body)
+	digest := hex.EncodeToString(h[:])
+	mark, _ := json.Marshal(map[string]any{"cluster_id": p.ClusterID, "node_id": p.NodeID, "revision": p.Revision, "digest": digest, "observed_at": time.Now().UTC()})
+	if err := os.WriteFile(path+".watermark", mark, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, body, 0600); err != nil {
+		t.Fatal(err)
+	}
+	return digest
+}
+
+func TestUniDERPPolicyFileIsAuthoritativeAndIPCOnlyNotifies(t *testing.T) {
+	dir, err := os.MkdirTemp("", "ud-ipc-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path, socket := filepath.Join(dir, "policy.json"), filepath.Join(dir, "policy.sock")
+	s := derpserver.New(key.NewNode(), logger.Discard)
+	defer s.Close()
+	closeIPC, err := startUniDERPPolicy(s, path, socket, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer closeIPC()
+	if s.UniDERPPolicyStatus().Usable {
+		t.Fatal("missing cache opened relay")
+	}
+	now := time.Now().UTC()
+	p := derpserver.UniDERPPolicy{ClusterID: "cluster", NodeID: "node", Revision: 1, GeneratedAt: now, Grants: []derpserver.UniDERPGrantPolicy{}, QoS: derpserver.UniDERPQoSPolicy{BudgetBPS: 100000000, OwnerWeight: 8, SharedWeight: 2, Tailnets: []derpserver.UniDERPPolicyTailnetQoS{}}}
+	digest := writeTestPolicyCache(t, path, p)
+	call := func(body string) policyIPCResponse {
+		t.Helper()
+		c, err := net.DialTimeout("unix", socket, time.Second)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(2 * time.Second))
+		c.Write([]byte(body + "\n"))
+		b, err := bufio.NewReader(c).ReadBytes('\n')
+		if err != nil {
+			t.Fatal(err)
+		}
+		var result policyIPCResponse
+		if err := json.Unmarshal(b, &result); err != nil {
+			t.Fatal(err)
+		}
+		return result
+	}
+	body, _ := json.Marshal(map[string]any{"revision": p.Revision, "digest": digest})
+	if result := call(string(body)); result.Error != "" || result.Revision != p.Revision || result.Usable {
+		t.Fatal("real empty-policy ACK wrong", result)
+	}
+	if result := call(`{"revision":2,"digest":"wrong","policy":{}}`); result.Error == "" || result.Revision != p.Revision {
+		t.Fatal("IPC accepted independent policy authority", result)
+	}
+	p.Revision++
+	digest = writeTestPolicyCache(t, path, p)
+	if err := os.WriteFile(path, []byte(`{}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	body, _ = json.Marshal(map[string]any{"revision": p.Revision, "digest": digest})
+	if result := call(string(body)); result.Error == "" || result.Revision != 1 {
+		t.Fatal("corrupt file claimed applied", result)
+	}
+}
+
+func TestUniDERPPolicyHostBudgetRejectsCachedAndHotPolicy(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "policy.json")
+	s := derpserver.New(key.NewNode(), logger.Discard)
+	defer s.Close()
+	s.EnableUniDERP()
+	p := derpserver.UniDERPPolicy{ClusterID: "cluster", NodeID: "node", Revision: 1, GeneratedAt: time.Now().UTC(), Grants: []derpserver.UniDERPGrantPolicy{}, QoS: derpserver.UniDERPQoSPolicy{BudgetBPS: 100000000, OwnerWeight: 8, SharedWeight: 2, Tailnets: []derpserver.UniDERPPolicyTailnetQoS{}}}
+	digest := writeTestPolicyCache(t, path, p)
+	if err := loadUniDERPPolicy(s, path, policyIPCRequest{}, 80000000); err == nil || s.UniDERPPolicyStatus().Revision != 0 {
+		t.Fatal("cached policy bypassed local host ceiling", err)
+	}
+	if err := loadUniDERPPolicy(s, path, policyIPCRequest{Revision: 1, Digest: digest}, 100000000); err != nil {
+		t.Fatal(err)
+	}
+	p.Revision++
+	p.QoS.BudgetBPS = 200000000
+	digest = writeTestPolicyCache(t, path, p)
+	if err := loadUniDERPPolicy(s, path, policyIPCRequest{Revision: 2, Digest: digest}, 100000000); err == nil || s.UniDERPPolicyStatus().Revision != 1 {
+		t.Fatal("hot policy bypassed ceiling or replaced old application", err)
+	}
+}
