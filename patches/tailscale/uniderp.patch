+package derpserver
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+)
+
+type qosTestFlow struct {
+	id     string
+	group  string
+	weight uint32
+	size   int
+	demand uint64
+}
+
+func TestUniDERPQoSOwnerReturnAndGuestCount(t *testing.T) {
+	flows := []qosTestFlow{{"owner", "owner", 1, 1200, 0}}
+	for i := range 10 {
+		flows = append(flows, qosTestFlow{fmt.Sprintf("guest-%d", i), "shared", 1, 300, 0})
+	}
+	counts, window, first := deterministicQoS(t, flows, 0, time.Second)
+	if first["owner"] > time.Second+2*time.Millisecond {
+		t.Fatal("owner did not recover service promptly", first["owner"])
+	}
+	owner := float64(counts["owner"]) * 8 / window.Seconds() / 1000000
+	var shared uint64
+	for _, f := range flows[1:] {
+		shared += counts[f.id]
+		if counts[f.id] == 0 {
+			t.Fatal("positive-weight guest starved", f.id)
+		}
+	}
+	if owner < 78.4 || owner > 81.6 || float64(shared)*8/window.Seconds()/1000000 < 19.6 {
+		t.Fatal("guest count diluted owner group", owner, shared)
+	}
