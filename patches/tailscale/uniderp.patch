+func deterministicQoS(t *testing.T, flows []qosTestFlow, sharedMax uint64, ownerStart time.Duration) (map[string]uint64, time.Duration, map[string]time.Duration) {
+	t.Helper()
+	s := &uniderpScheduler{budget: uniderpBucket{rate: 12500000}}
+	s.groups[0].weight, s.groups[1].weight = 8, 2
+	s.groups[1].bucket.rate = sharedMax
+	queues := make([]*uniderpTailnetQueue, len(flows))
+	requests := make([][]*uniderpRequest, len(flows))
+	all := make([][]*uniderpRequest, len(flows))
+	for i, f := range flows {
+		group := 0
+		if f.group == "shared" {
+			group = 1
+		}
+		q := &uniderpTailnetQueue{id: f.id, weight: int64(f.weight)}
+		queues[i] = q
+		s.groups[group].tailnets = append(s.groups[group].tailnets, q)
+		for range 64 {
+			requests[i] = append(requests[i], &uniderpRequest{ctx: context.Background(), size: f.size, done: make(chan error, 1)})
+		}
+		all[i] = append([]*uniderpRequest(nil), requests[i]...)
+	}
+	counts, baseline := map[string]uint64{}, map[string]uint64{}
+	first := make(map[string]time.Duration)
+	var offered = make([]float64, len(flows))
+	start := time.Date(2026, 10, 3, 0, 0, 0, 0, time.UTC)
+	const tick = 200 * time.Microsecond
+	const warmup = time.Second
+	const duration = 4 * time.Second
+	for elapsed := time.Duration(0); elapsed <= warmup+duration; elapsed += tick {
+		for i, f := range flows {
+			if f.group == "owner" && elapsed < ownerStart {
+				continue
+			}
+			if f.demand == 0 {
+				offered[i] = float64(f.size * 64)
+			} else {
+				offered[i] += float64(f.demand) * tick.Seconds()
+			}
+			for len(requests[i]) > 0 && offered[i] >= float64(f.size) {
+				r := requests[i][len(requests[i])-1]
+				requests[i] = requests[i][:len(requests[i])-1]
+				queues[i].requests = append(queues[i].requests, r)
+				queues[i].queuedBytes += r.size
+				queues[i].idleSince = time.Time{}
+				offered[i] -= float64(f.size)
+			}
+		}
+		for s.step(start.Add(elapsed)) {
+			for i, f := range flows {
+				for _, r := range all[i] {
+					select {
+					case err := <-r.done:
+						if err != nil {
+							t.Fatal(err)
+						}
+						if _, ok := first[f.id]; !ok {
+							first[f.id] = elapsed
+						}
+						counts[f.id] += uint64(f.size)
+						requests[i] = append(requests[i], r)
+					default:
+					}
+				}
+			}
+		}
+		if elapsed == warmup {
+			for _, f := range flows {
+				baseline[f.id] = counts[f.id]
+			}
+		}
+	}
+	for _, f := range flows {
+		counts[f.id] -= baseline[f.id]
+	}
+	return counts, duration, first
+}
