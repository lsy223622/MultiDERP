+func uniderpClient(t *testing.T, s *Server, k key.NodePrivate) *derp.Client {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	conn, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	in, err := ln.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	go s.Accept(context.Background(), in, bufio.NewReadWriter(bufio.NewReader(in), bufio.NewWriter(in)), "127.0.0.1:12345")
+	conn.SetDeadline(time.Now().Add(3 * time.Second))
+	c, err := derp.NewClient(k, conn, bufio.NewReadWriter(bufio.NewReader(conn), bufio.NewWriter(conn)), logger.Discard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
