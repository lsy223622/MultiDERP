+
+func TestUniDERPSharedWireFixture(t *testing.T) {
+	b, err := os.ReadFile("testdata/uniderp-policy.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := DecodeUniDERPPolicy(bytes.NewReader(b), "cluster", "node")
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(p)
+	if err != nil || !bytes.Equal(encoded, b) || p.Revision != 7 || p.Grants[0].GrantRevision != 3 || p.QoS.SharedMaxBPS != 40000000 {
+		t.Fatal("wire semantics changed", err)
+	}
+	for i, hour := range []int{2, 3} {
+		if !UniDERPEffectiveUntil(p.Grants[0], p.Grants[0].Keys[i]).Equal(p.GeneratedAt.Add(time.Duration(hour) * time.Hour)) {
+			t.Fatal("wire deadline changed", i)
+		}
+	}
+}
+
+func testUniDERPPolicy(keys map[key.NodePublic]string, now time.Time) UniDERPPolicy {
+	p := UniDERPPolicy{ClusterID: "cluster", NodeID: "node", Revision: 1, GeneratedAt: now, Grants: []UniDERPGrantPolicy{}, QoS: UniDERPQoSPolicy{BudgetBPS: 8000000000, OwnerWeight: 8, SharedWeight: 2, Tailnets: []UniDERPPolicyTailnetQoS{}}}
+	byTailnet := make(map[string][]UniDERPDeviceKey)
+	for k, tn := range keys {
+		byTailnet[tn] = append(byTailnet[tn], UniDERPDeviceKey{NodePublic: k.String()})
+	}
+	var ids []string
+	for id := range byTailnet {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		sort.Slice(byTailnet[id], func(i, j int) bool { return byTailnet[id][i].NodePublic < byTailnet[id][j].NodePublic })
+		p.Grants = append(p.Grants, UniDERPGrantPolicy{GrantID: id, GrantRevision: 1, TailnetID: id, LastIdentitySuccess: now, IdentityUntil: now.Add(time.Hour), ControlUntil: now.Add(time.Hour), Keys: byTailnet[id]})
+		p.QoS.Tailnets = append(p.QoS.Tailnets, UniDERPPolicyTailnetQoS{TailnetID: id, Group: "shared", Weight: 1})
+	}
+	return p
+}
+
+func installTestPolicy(t *testing.T, s *Server, p UniDERPPolicy) {
+	t.Helper()
+	b, err := json.Marshal(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := s.ApplyUniDERPPolicy(b)
+	if err != nil || result.Revision != p.Revision {
+		t.Fatal("policy not applied", result, err)
+	}
+}
+
+func assertDERPClosed(t *testing.T, c *derp.Client) {
+	t.Helper()
+	for {
+		_, err := c.Recv()
+		if err == nil {
+			continue
+		}
+		var networkError net.Error
+		if errors.As(err, &networkError) && networkError.Timeout() {
+			t.Fatal("connection did not close before read deadline", err)
+		}
+		return
+	}
+}
+
+func TestRevocationClosesExistingConnection(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	a, b := key.NewNode(), key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{a.Public(): "a", b.Public(): "a"}, time.Now())
+	installTestPolicy(t, s, p)
+	ca, cb := uniderpClient(t, s, a), uniderpClient(t, s, b)
+	if _, err := ca.Recv(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := cb.Recv(); err != nil {
+		t.Fatal(err)
+	}
+	p.Revision++
+	p.Grants[0].Keys = []UniDERPDeviceKey{{NodePublic: b.Public().String()}}
+	installTestPolicy(t, s, p)
+	assertDERPClosed(t, ca)
+	if !s.IsClientConnectedForTest(b.Public()) {
+		t.Fatal("unaffected connection dropped")
+	}
+}
+
+func TestExpiryClosesWithoutUpdate(t *testing.T) {
+	clock := tstest.NewClock(tstest.ClockOpts{Start: time.Now()})
+	s := New(key.NewNode(), logger.Discard)
+	s.clock = clock
+	t.Cleanup(func() { s.Close() })
+	k := key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{k.Public(): "a"}, clock.Now())
+	p.Grants[0].ControlUntil = clock.Now().Add(time.Minute)
+	installTestPolicy(t, s, p)
+	c := uniderpClient(t, s, k)
+	if _, err := c.Recv(); err != nil {
+		t.Fatal(err)
+	}
+	clock.Advance(2 * time.Minute)
+	assertDERPClosed(t, c)
+	if c := uniderpClient(t, s, k); c != nil {
+		if _, err := c.Recv(); err == nil {
+			t.Fatal("expired key reconnected")
+		}
+	}
+}
+
+func TestReplayCannotRestoreRevokedKey(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	k := key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{k.Public(): "a"}, time.Now())
+	installTestPolicy(t, s, p)
+	old, _ := json.Marshal(p)
+	p.Revision++
+	p.Grants = []UniDERPGrantPolicy{}
+	p.QoS.Tailnets = []UniDERPPolicyTailnetQoS{}
+	installTestPolicy(t, s, p)
+	if _, err := s.ApplyUniDERPPolicy(old); err == nil {
+		t.Fatal("lower revision accepted")
+	}
+	p.QoS.BudgetBPS++
+	changed, _ := json.Marshal(p)
+	if _, err := s.ApplyUniDERPPolicy(changed); err == nil {
+		t.Fatal("same revision changed content")
+	}
+	c := uniderpClient(t, s, k)
+	if _, err := c.Recv(); err == nil {
+		t.Fatal("revoked key restored")
+	}
+}
+
+func TestInvalidUpdateKeepsOnlyValidOldPolicy(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	k := key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{k.Public(): "a"}, time.Now())
+	installTestPolicy(t, s, p)
+	if _, err := s.ApplyUniDERPPolicy([]byte(`{"revision":2}`)); err == nil {
+		t.Fatal("invalid policy applied")
+	}
+	c := uniderpClient(t, s, k)
+	if _, err := c.Recv(); err != nil {
+		t.Fatal("valid old policy lost", err)
+	}
+	p.Revision++
+	p.NodeID = "other"
+	b, _ := json.Marshal(p)
+	if _, err := s.ApplyUniDERPPolicy(b); err == nil {
+		t.Fatal("wrong node policy applied")
+	}
+}
+
+func TestPolicyClockRollbackCannotExtendAuthorization(t *testing.T) {
+	clock := tstest.NewClock(tstest.ClockOpts{Start: time.Now()})
+	s := New(key.NewNode(), logger.Discard)
+	s.clock = clock
+	t.Cleanup(func() { s.Close() })
+	k := key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{k.Public(): "a"}, clock.Now())
+	installTestPolicy(t, s, p)
+	c := uniderpClient(t, s, k)
+	if _, err := c.Recv(); err != nil {
+		t.Fatal(err)
+	}
+	clock.Advance(10 * time.Minute)
+	s.UniDERPPolicyStatus()
+	clock.Advance(-time.Minute)
+	if s.UniDERPPolicyStatus().Usable {
+		t.Fatal("clock rollback retained usable policy")
+	}
+	assertDERPClosed(t, c)
+}
