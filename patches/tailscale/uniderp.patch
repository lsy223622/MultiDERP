+func TestUniDERPQoSBorrowingAndCeiling(t *testing.T) {
+	for _, ceiling := range []uint64{0, 200000} {
+		s := newUniDERPScheduler(1000000, 8, 2, ceiling, []UniDERPTailnetQoS{{"a", "shared", 1, 0}})
+		ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+		var n int64
+		for s.wait(ctx, "a", 1200) == nil {
+			n += 1200
+		}
+		cancel()
+		s.close()
+		if ceiling == 0 && n < 800000 {
+			t.Fatalf("idle capacity not borrowed: %d", n)
+		}
+		if ceiling != 0 && n > 200000+2*65536 {
+			t.Fatalf("ceiling exceeded beyond bounded burst: %d", n)
+		}
+	}
+}
