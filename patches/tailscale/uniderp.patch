+package main
+
+import (
+	"errors"
+	"flag"
+	"net"
+	"net/http"
+	"net/http/httputil"
+	"net/url"
+	"strconv"
+)
+
+var uniderpManagementURL = flag.String("uniderp-management-url", "", "UniDERP loopback HTTP management backend")
+
+func mountUniDERPRoutes(mux *http.ServeMux, backend string) error {
+	if backend == "" {
+		return nil
+	}
+	u, err := url.Parse(backend)
+	if err != nil {
+		return err
+	}
+	ip := net.ParseIP(u.Hostname())
+	port, err := strconv.ParseUint(u.Port(), 10, 16)
+	if err != nil || port == 0 || ip == nil || !ip.IsLoopback() || u.Scheme != "http" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" {
+		return errors.New("UniDERP management backend must be a loopback HTTP origin with a numeric port")
+	}
+	proxy := httputil.NewSingleHostReverseProxy(u)
+	proxy.FlushInterval = -1
+	for _, path := range []string{"/cluster/v1/", "/api/v1/", "/manage/"} {
+		mux.Handle(path, proxy)
+	}
+	return nil
+}
