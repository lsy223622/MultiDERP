+package derpserver
+
+import (
+	"encoding/json"
+	"testing"
+	"time"
+
+	"tailscale.com/derp"
+	"tailscale.com/types/key"
+	"tailscale.com/types/logger"
+)
+
+func TestUniDERPTrafficCountsPayloadDirectionsOnce(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	defer s.Close()
+	a, b := key.NewNode(), key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{a.Public(): "a", b.Public(): "a"}, time.Now())
+	installTestPolicy(t, s, p)
+	ca, cb := uniderpClient(t, s, a), uniderpClient(t, s, b)
+	for _, c := range []*derp.Client{ca, cb} {
+		if _, err := c.Recv(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	payload := []byte("actual traffic")
+	if err := ca.Send(b.Public(), payload); err != nil {
+		t.Fatal(err)
+	}
+	for {
+		msg, err := cb.Recv()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, ok := msg.(derp.ReceivedPacket); ok {
+			break
+		}
+	}
+	read := func() map[string]any {
+		t.Helper()
+		body, _ := json.Marshal(s.UniDERPPolicyStatus())
+		var state map[string]any
+		json.Unmarshal(body, &state)
+		if state["active_connections"] != float64(2) {
+			t.Fatal("actual active connection count missing", string(body))
+		}
+		traffic, ok := state["traffic"].([]any)
+		if !ok || len(traffic) != 1 {
+			t.Fatal("missing bounded tailnet traffic", string(body))
+		}
+		return traffic[0].(map[string]any)
+	}
+	tally := read()
+	id := s.UniDERPPolicyStatus().Traffic[0].CounterID
+	if id == 0 {
+		t.Fatal("traffic counter identity missing", tally)
+	}
+	for _, field := range []string{"rx_payload_bytes", "tx_payload_bytes", "relayed_payload_bytes"} {
+		if tally[field] != float64(len(payload)) {
+			t.Fatal("direction double-counted or missing", field, tally)
+		}
+	}
+	if tally["tailnet_id"] != "a" || tally["queued_payload_bytes"] != float64(0) {
+		t.Fatal(tally)
+	}
+	p.Revision++
+	p.QoS.OwnerWeight = 9
+	installTestPolicy(t, s, p)
+	if after := read(); after["relayed_payload_bytes"] != tally["relayed_payload_bytes"] || s.UniDERPPolicyStatus().Traffic[0].CounterID != id {
+		t.Fatal("hot policy reset traffic", after)
+	}
+	kept := p
+	p.Revision++
+	p.Grants = []UniDERPGrantPolicy{}
+	p.QoS.Tailnets = []UniDERPPolicyTailnetQoS{}
+	installTestPolicy(t, s, p)
+	kept.Revision = p.Revision + 1
+	installTestPolicy(t, s, kept)
+	body, _ := json.Marshal(s.UniDERPPolicyStatus())
+	var state map[string]any
+	json.Unmarshal(body, &state)
+	if s.UniDERPPolicyStatus().Traffic[0].CounterID == id {
+		t.Fatal("rebuilt counter reused identity", string(body))
+	}
+}
+
+func TestUniDERPTrafficIdentityChangesAfterRestart(t *testing.T) {
+	private := key.NewNode()
+	p := testUniDERPPolicy(map[key.NodePublic]string{key.NewNode().Public(): "a"}, time.Now())
+	var first uint64
+	for i := 0; i < 2; i++ {
+		s := New(private, logger.Discard)
+		installTestPolicy(t, s, p)
+		id := s.UniDERPPolicyStatus().Traffic[0].CounterID
+		s.Close()
+		if id == 0 || id == first {
+			t.Fatal("server restart reused traffic identity", id)
+		}
+		first = id
+	}
+}
