+func TestKnownKeysAndUnknownKeyDenied(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	t.Cleanup(func() { s.Close() })
+	a, b := key.NewNode(), key.NewNode()
+	installTestPolicy(t, s, testUniDERPPolicy(map[key.NodePublic]string{a.Public(): "tailnet-a", b.Public(): "tailnet-a"}, time.Now()))
+	ca, cb := uniderpClient(t, s, a), uniderpClient(t, s, b)
+	for _, c := range []*derp.Client{ca, cb} {
+		if _, err := c.Recv(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	unknown := uniderpClient(t, s, key.NewNode())
+	if _, err := unknown.Recv(); err == nil {
+		t.Fatal("unknown key admitted")
+	}
+	for _, size := range []int{64, 1200, 60000} {
+		payload := bytes.Repeat([]byte{42}, size)
+		if err := ca.Send(b.Public(), payload); err != nil {
+			t.Fatal(err)
+		}
+		for {
+			msg, err := cb.Recv()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if p, ok := msg.(derp.ReceivedPacket); ok {
+				if p.Source != a.Public() || !bytes.Equal(p.Data, payload) {
+					t.Fatal("relay payload mismatch")
+				}
+				break
+			}
+		}
+	}
+	s.mu.Lock()
+	cs, _ := s.clients.Load(a.Public())
+	got := cs.activeClient.Load().uniderpTailnet
+	s.mu.Unlock()
+	if got != "tailnet-a" {
+		t.Fatalf("binding = %q", got)
+	}
+}
