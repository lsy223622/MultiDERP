+		{"shared small demand", []qosTestFlow{{"owner", "owner", 1, 1200, 0}, {"a", "shared", 1, 300, 625000}}, 0, map[string]float64{"owner": 95, "a": 5}},
+		{"shared hard ceiling", []qosTestFlow{{"a", "shared", 1, 300, 0}}, 5000000, map[string]float64{"a": 40}},
