+func TestUniDERPQueuedPayloadBytesBoundedAcrossConnections(t *testing.T) {
+	s := New(key.NewNode(), logger.Discard)
+	defer s.Close()
+	source := &sclient{s: s, key: key.NewNode().Public()}
+	keys := map[key.NodePublic]string{source.key: "a"}
+	var destinations []*sclient
+	for range 64 {
+		c := &sclient{s: s, key: key.NewNode().Public(), ctx: context.Background(), uniderpTailnet: "a", sendQueue: make(chan pkt, 32), discoSendQueue: make(chan pkt, 32)}
+		keys[c.key] = "a"
+		destinations = append(destinations, c)
+	}
+	installTestPolicy(t, s, testUniDERPPolicy(keys, time.Now()))
+	for _, c := range destinations {
+		c.uniderpGrant = s.uniderpPolicy.keys[c.key].grant
+	}
+	for _, c := range destinations {
+		for range 32 {
+			if err := source.sendPkt(c, pkt{src: source.key, bs: make([]byte, 60000)}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	var bytes int
+	for _, c := range destinations {
+		for len(c.sendQueue) > 0 {
+			p := <-c.sendQueue
+			bytes += len(p.bs)
+			p.uniderpRelease()
+		}
+	}
+	if bytes == 0 {
+		t.Fatal("all authorized payloads dropped")
+	}
+	if queued := s.uniderpPolicy.traffic["a"].queued.Load(); queued != 0 {
+		t.Fatal("drain retained queue budget", queued)
+	}
+	if bytes > 1<<20 {
+		t.Fatalf("one tailnet retained %d queued payload bytes across 64 connections, limit 1MiB", bytes)
+	}
+	c := destinations[0]
+	for range 40 {
+		source.sendPkt(c, pkt{src: source.key, bs: make([]byte, 1000)})
+	}
+	if got := s.uniderpPolicy.traffic["a"].queued.Load(); got != 32000 {
+		t.Fatal("queue head drop leaked byte budget", got)
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	c.ctx = ctx
+	for len(c.sendQueue) > 0 {
+		if err := c.sendQueuedPacket(<-c.sendQueue); err == nil {
+			t.Fatal("cancelled writer accepted packet")
+		}
+	}
+	if got := s.uniderpPolicy.traffic["a"].queued.Load(); got != 0 {
+		t.Fatal("cancelled writer leaked payload bytes", got)
+	}
+}
