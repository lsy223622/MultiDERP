+package main
+
+import (
+	"bufio"
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"flag"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"tailscale.com/derp/derpserver"
+)
+
+var uniderpPolicyFile = flag.String("uniderp-policy-file", "", "UniDERP authoritative policy cache")
+var uniderpPolicySocket = flag.String("uniderp-policy-socket", "", "UniDERP protected local policy notification socket")
+var uniderpMaxBudgetBPS = flag.Uint64("uniderp-max-budget-bps", 0, "Local host DERP budget ceiling in bits per second")
+
+type policyIPCRequest struct {
+	Revision uint64 `json:"revision"`
+	Digest   string `json:"digest"`
+}
+type policyIPCResponse struct {
+	Revision          uint64                             `json:"revision"`
+	Usable            bool                               `json:"usable"`
+	Error             string                             `json:"error"`
+	Traffic           []derpserver.UniDERPTailnetTraffic `json:"traffic,omitempty"`
+	TrafficObservedAt time.Time                          `json:"traffic_observed_at"`
+	ActiveConnections uint64                             `json:"active_connections"`
+}
+type policyWatermark struct {
+	ClusterID  string    `json:"cluster_id"`
+	NodeID     string    `json:"node_id"`
+	Revision   uint64    `json:"revision"`
+	Digest     string    `json:"digest"`
+	ObservedAt time.Time `json:"observed_at"`
+}
+
+func decodePolicyLocal(b []byte, dst any) error {
+	d := json.NewDecoder(bytes.NewReader(b))
+	d.DisallowUnknownFields()
+	if err := d.Decode(dst); err != nil {
+		return err
+	}
+	if d.Decode(new(any)) != io.EOF {
+		return errors.New("trailing policy data")
+	}
+	return nil
+}
+
+func readPolicyFile(path string, max int64) ([]byte, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	b, err := io.ReadAll(io.LimitReader(f, max+1))
+	if err != nil || int64(len(b)) > max {
+		return nil, errors.New("policy file unreadable or oversized")
+	}
+	return b, nil
+}
+
+func loadUniDERPPolicy(s *derpserver.Server, path string, expected policyIPCRequest, maxBudget uint64) error {
+	mark, err := readPolicyFile(path+".watermark", 4096)
+	if err != nil {
+		return err
+	}
+	var m policyWatermark
+	if decodePolicyLocal(mark, &m) != nil || m.Revision == 0 || m.ObservedAt.IsZero() || time.Now().Before(m.ObservedAt.Add(-5*time.Second)) {
+		return errors.New("invalid policy watermark")
+	}
+	body, err := readPolicyFile(path, derpserver.MaxUniDERPPolicyBytes)
+	if err != nil {
+		return err
+	}
+	h := sha256.Sum256(body)
+	digest := hex.EncodeToString(h[:])
+	if digest != m.Digest || (expected.Revision != 0 && (expected.Revision != m.Revision || expected.Digest != digest)) {
+		return errors.New("policy digest mismatch")
+	}
+	p, err := derpserver.DecodeUniDERPPolicy(bytes.NewReader(body), m.ClusterID, m.NodeID)
+	if err != nil || p.Revision != m.Revision {
+		return errors.New("policy binding mismatch")
+	}
+	if maxBudget > 0 && p.QoS.BudgetBPS > maxBudget {
+		return errors.New("local host budget exceeded")
+	}
+	_, err = s.ApplyUniDERPPolicy(body)
+	return err
+}
+
+func startUniDERPPolicy(s *derpserver.Server, path, socket string, maxBudget uint64) (func(), error) {
+	if !filepath.IsAbs(path) || !filepath.IsAbs(socket) || filepath.Dir(path) != filepath.Dir(socket) {
+		return nil, errors.New("UniDERP requires policy file and socket in the same protected directory")
+	}
+	s.EnableUniDERP()
+	dir := filepath.Dir(socket)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(dir, 0700); err != nil {
+		return nil, err
+	}
+	if info, err := os.Lstat(socket); err == nil {
+		if info.Mode()&os.ModeSocket == 0 {
+			return nil, errors.New("policy socket path is not a socket")
+		}
+		if err := os.Remove(socket); err != nil {
+			return nil, err
+		}
+	} else if !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	ln, err := net.Listen("unix", socket)
+	if err != nil {
+		return nil, err
+	}
+	if err := os.Chmod(socket, 0600); err != nil {
+		ln.Close()
+		return nil, err
+	}
+	lastError := ""
+	if err := loadUniDERPPolicy(s, path, policyIPCRequest{}, maxBudget); err != nil && !errors.Is(err, os.ErrNotExist) {
+		lastError = "invalid_cache"
+	}
+	done := make(chan struct{})
+	var mu sync.Mutex
+	var active net.Conn
+	stopping := false
+	go func() {
+		defer close(done)
+		defer os.Remove(socket)
+		for {
+			conn, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			if stopping {
+				mu.Unlock()
+				conn.Close()
+				return
+			}
+			active = conn
+			mu.Unlock()
+			conn.SetDeadline(time.Now().Add(5 * time.Second))
+			b, readErr := bufio.NewReader(io.LimitReader(conn, 4097)).ReadBytes('\n')
+			var request policyIPCRequest
+			errorCode := ""
+			if readErr != nil || len(b) > 4096 || decodePolicyLocal(b, &request) != nil || (request.Revision == 0 && request.Digest != "") {
+				errorCode = "invalid_request"
+			} else if request.Revision != 0 {
+				if len(request.Digest) != 64 {
+					errorCode = "invalid_request"
+				} else if _, err := hex.DecodeString(request.Digest); err != nil {
+					errorCode = "invalid_request"
+				} else if err := loadUniDERPPolicy(s, path, request, maxBudget); err != nil {
+					lastError = "apply_failed"
+				} else {
+					lastError = ""
+				}
+			}
+			if errorCode == "" {
+				errorCode = lastError
+			}
+			state := s.UniDERPPolicyStatus()
+			json.NewEncoder(conn).Encode(policyIPCResponse{Revision: state.Revision, Usable: state.Usable, Error: errorCode, Traffic: state.Traffic, TrafficObservedAt: state.TrafficObservedAt, ActiveConnections: state.ActiveConnections})
+			mu.Lock()
+			active = nil
+			mu.Unlock()
+			conn.Close()
+		}
+	}()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			ln.Close()
+			mu.Lock()
+			stopping = true
+			if active != nil {
+				active.Close()
+			}
+			mu.Unlock()
+			<-done
+		})
+	}, nil
+}
